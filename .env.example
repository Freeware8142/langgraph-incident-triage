# Environment Variables for Incident Triage System
# Copy this file to .env and fill in your values

# Microsoft Graph API Credentials
MS_GRAPH_CLIENT_ID=your-client-id-here
MS_GRAPH_CLIENT_SECRET=your-client-secret-here

# Tines API Key
TINES_API_KEY=your-tines-api-key-here

# LangSmith API Key (for LangGraph tracing)
LANGSMITH_API_KEY=your-langsmith-api-key-here

# Application Settings
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=INFO

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your-openai-api-key-here
